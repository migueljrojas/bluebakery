# Copia este archivo como .env.local y completa los valores.
# En Vercel: Project Settings > Environment Variables.

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase (cliente) — Firebase Console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (servidor) — Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pegar la clave entre comillas, con los \n tal como vienen en el JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Precio del acceso lifetime
RECETARIO_PRECIO_USD=5

# --- PayPal — developer.paypal.com > Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox: https://api-m.sandbox.paypal.com | Producción: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Pago Móvil (datos que se muestran al cliente)
PAGO_MOVIL_BANCO_CODIGO=0102
PAGO_MOVIL_BANCO_NOMBRE=Banco de Venezuela
PAGO_MOVIL_TELEFONO=04140000000
PAGO_MOVIL_DOCUMENTO=V-00000000
PAGO_MOVIL_TITULAR=Blue Bakery

# --- Administración de pagos
# Correos (separados por coma) que pueden entrar a /admin para aprobar pagos
ADMIN_EMAILS=admin@ejemplo.com
